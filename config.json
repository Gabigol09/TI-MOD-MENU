{
  "_comment": "TI Director Mode — edite este arquivo para adaptar a qualquer empresa. Nao requer recompilacao. JSON nao aceita comentarios com //, entao usamos campos '_comment' — pode deixar ou apagar, nao afetam o funcionamento.",
  "_version": "1.0",

  "company": {
    "_comment": "Nome exibido no app. So identificacao visual, nao afeta nenhum comando.",
    "name": "Minha Empresa",
    "environment": "production"
  },

  "network": {
    "_comment": "Servidor e unidade usados pelo botao 'Mapear Soft (S:)'.",
    "softServer":   "\\\\servidor\\soft",
    "softDrive":    "S:",
    "gateway":      "192.168.1.1",
    "wifiProfile":  "CORP_WIFI"
  },

  "paths": {
    "_comment": "Caminho completo (UNC) de cada instalador na categoria Instalacoes. Troque so o texto entre aspas pelo caminho real da sua empresa - nao precisa mexer em codigo.",
    "office365":         "\\\\servidor\\soft\\Office365\\setup.exe",
    "office2016":        "\\\\servidor\\soft\\Office2016\\setup.exe",
    "office2016Config":  "\\\\servidor\\soft\\Office2016\\config.xml",
    "teams":             "\\\\servidor\\soft\\Teams\\MSTeamsSetup.exe",
    "chrome":            "\\\\servidor\\soft\\Chrome\\ChromeSetup.exe",
    "adobeReader":       "\\\\servidor\\soft\\Adobe\\AcroRead.msi",
    "pdfCreator":        "\\\\servidor\\soft\\PDFCreator\\setup.exe",
    "greenshot":         "\\\\servidor\\soft\\Greenshot\\Install.cmd",
    "notepadPlusPlus":   "\\\\servidor\\soft\\NotepadPlusPlus\\installer.exe",
    "firefox":           "\\\\servidor\\soft\\Firefox\\setup.msi",
    "powerBI":           "\\\\servidor\\soft\\PowerBI\\PBIDesktopSetup_x64.exe"
  },

  "hostname": {
    "_comment": "Padrao de nome de maquina (hostname) usado pelo script 'Preparar maquina nova' para detectar se e notebook ou desktop. Ajuste o 'pattern' (regex) e o 'notebookPrefix' para a convencao de nomenclatura da sua empresa.",
    "pattern":            "^[A-Za-z]{2}\\d{5}S$",
    "patternDescription": "2 letras + 5 numeros + S (ex: AB12345S)",
    "notebookPrefix":     "NB"
  },

  "deploy": {
    "_comment": "Catalogo de categorias e softwares para o modulo Deploy. Pode ser editado direto pela tela de Configuracoes > Deploy.",
    "categories": [
      {
        "id": "cat-basicos",
        "name": "Softwares Básicos",
        "softwares": [
          {
            "id": "soft-chrome",
            "name": "Google Chrome",
            "type": "executable",
            "path": "\\\\servidor\\soft\\Chrome\\ChromeSetup.exe",
            "args": "/silent /install",
            "description": "Navegador padrão",
            "defaultForPreparation": true
          },
          {
            "id": "soft-adobe",
            "name": "Adobe Acrobat Reader",
            "type": "executable",
            "path": "\\\\servidor\\soft\\Adobe\\AcroRead.msi",
            "args": "/qn",
            "description": "Leitor de PDF",
            "defaultForPreparation": true
          },
          {
            "id": "soft-teams",
            "name": "Microsoft Teams",
            "type": "executable",
            "path": "\\\\servidor\\soft\\Teams\\MSTeamsSetup.exe",
            "args": "",
            "description": "Comunicação corporativa",
            "defaultForPreparation": true
          }
        ]
      },
      {
        "id": "cat-opcionais",
        "name": "Opcionais",
        "softwares": [
          {
            "id": "soft-greenshot",
            "name": "Greenshot",
            "type": "script",
            "path": "\\\\servidor\\soft\\Greenshot\\Install.cmd",
            "args": "",
            "description": "Captura de tela"
          },
          {
            "id": "soft-notepadpp",
            "name": "Notepad++",
            "type": "executable",
            "path": "\\\\servidor\\soft\\NotepadPlusPlus\\installer.exe",
            "args": "/S",
            "description": "Editor de texto avançado"
          },
          {
            "id": "soft-powerbi",
            "name": "Power BI Desktop",
            "type": "executable",
            "path": "\\\\servidor\\soft\\PowerBI\\PBIDesktopSetup_x64.exe",
            "args": "-quiet -norestart ACCEPT_EULA=1",
            "description": "Relatórios e dashboards"
          }
        ]
      }
    ]
  },

  "log": {
    "_comment": "Onde o app grava o historico de comandos executados (arquivo texto simples, sem senha).",
    "path": "C:\\Suporte\\TIDirectorMode.log",
    "dir":  "C:\\Suporte"
  }
}
