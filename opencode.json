{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",

      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },

      "models": {
        "ti-director-dev": {
          "name": "TI Director Dev"
        }
      }
    }
  },

  "mcp": {
    "overclick": {
      "type": "remote",
      "url": "http://localhost:3000/mcp",
      "enabled": true,
      "oauth": false,

      "headers": {
        "Authorization": "Bearer {env:OVERCLICK_TOKEN}"
      }
    }
  }
}