{
  "name": "ti-director-mode",
  "version": "1.5.0",
  "description": "TI Director Mode - Embraer Edition",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.embraer.ti-director",
    "productName": "TI Director Mode",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "TI_DirectorMode_v1.5.exe"
    }
  }
}
